---
interface Props {
    title: string;
    categories?: string[];
}

const { title, categories = [] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="パンくずリスト">
    <ol>
        <li><a href="/">ホーム</a></li>
        <li><a href="/blog">ブログ</a></li>
        {categories && categories.length > 0 && (
            <li><a href={`/blog/category/${categories[0]}`}>{categories[0]}</a></li>
        )}
        <li aria-current="page">{title}</li>
    </ol>
</nav>

<style>
    .breadcrumbs {
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
    }
    
    .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    
    .breadcrumbs li {
        display: flex;
        align-items: center;
    }
    
    .breadcrumbs li:not(:last-child)::after {
        content: "›";
        margin: 0 0.5rem;
        color: var(--text-color);
        opacity: 0.7;
    }
    
    .breadcrumbs a {
        color: var(--text-color);
        text-decoration: none;
        opacity: 0.8;
        transition: opacity 0.3s ease;
    }
    
    .breadcrumbs a:hover {
        opacity: 1;
        text-decoration: underline;
    }
    
    .breadcrumbs li:last-child {
        color: var(--text-color);
        font-weight: 500;
    }
    
    @media (max-width: 768px) {
        .breadcrumbs {
            font-size: 0.8rem;
        }
    }
</style>
