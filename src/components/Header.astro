---
import { Image } from 'astro:assets';
import Logo from '../assets/KanikanLab.svg';
---

<div class="header__inner">
    <a href="/" class="header__logo-link">
        <Image src={Logo} alt="KanikanLab" class="header__logo" />
        <span>KanikanLab</span>
    </a>
    <div class="menu-container">
        <a href="/about" class="about-text header-menu">About</a>
        <a href="/blog" class="blog-text header-menu">Blog</a>
    </div>
</div>
<style>
    .header__inner {
        position: fixed;
        z-index: 100;
        padding: 0 80px;
        display: flex;
        height: 80px;
        width: 100%;
        align-items: center;
        justify-content: space-between;
        background-color: var(--header-bg);
        border-bottom: 1px solid rgb(204, 204, 204);
        box-sizing: border-box;
    }

    .header__logo-link {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-color);
        text-decoration: none;
    }
    .header__inner .header__logo {
        width: 40px;
        height: 40px;
    }
    .menu-container {
        display: flex;
        gap: 60px;
    }
    .header__inner span {
        font-family: 'Krok', sans-serif;
        font-size: 24px;
        text-decoration: none;
        letter-spacing: 0.05em;
    }
    .header-menu {
        font-family: 'krok', sans-serif;
        font-size: 20px;
        text-decoration: none;
        color: var(--text-color);
    }
    .header-menu {
            position: relative;
        }
        .header-menu::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -2px;
            width: 100%;
            height: 1px;
            background: var(--text-color);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.3s ease;
        }
        .header-menu:hover::after {
            transform: scaleX(1);
        }

</style>

<style>
    :root {
        --header-bg: #fff;
    }
</style>
