---
// 記事の情報を受け取るためのpropsを設定
const { slug, title } = Astro.props;
---

<div class="like-share-bar">
  <div class="like-button">
    <button id="like-button" aria-label="いいねする">
      <i class="far fa-heart" id="like-icon"></i>
      <span id="like-count">0</span>
    </button>
  </div>
  
  <div class="share-buttons">
    <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(`${Astro.site}blog/${slug}`)}`} target="_blank" rel="noopener noreferrer" aria-label="Twitterでシェア">
      <i class="fab fa-twitter"></i>
    </a>
  </div>
</div>

<style>
  .like-share-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 2rem 0;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background-color: var(--bg-secondary);
  }

  .like-button button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: var(--text-color);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.5rem;
    transition: all 0.2s ease;
  }

  .like-button button:hover {
    color: #ff4b4b;
  }

  .like-button button i {
    font-size: 1.2rem;
  }

  .like-button button.liked i {
    color: #ff4b4b;
    font-weight: 900;
  }

  .share-buttons {
    display: flex;
    gap: 1rem;
  }

  .share-buttons a {
    color: var(--text-color);
    font-size: 1.2rem;
    transition: color 0.3s ease;
  }

  .share-buttons a:hover {
    color: var(--accent-color);
  }
</style>

<script define:vars={{ slug }}>
// ローカルストレージからいいね状態を取得
const storageKey = `like_${slug}`;
const likeButton = document.getElementById('like-button');
const likeIcon = document.getElementById('like-icon');
const likeCount = document.getElementById('like-count');

// 初期状態の設定
let isLiked = localStorage.getItem(storageKey) === 'true';
let count = parseInt(localStorage.getItem(`${storageKey}_count`) || '0');

// UIを更新する関数
function updateLikeUI() {
  if (isLiked) {
    likeIcon.classList.remove('far');
    likeIcon.classList.add('fas');
    likeButton.classList.add('liked');
  } else {
    likeIcon.classList.remove('fas');
    likeIcon.classList.add('far');
    likeButton.classList.remove('liked');
  }
  likeCount.textContent = count.toString();
}

// 初期UI更新
updateLikeUI();

// クリックイベントの設定
likeButton.addEventListener('click', () => {
  isLiked = !isLiked;
  count = isLiked ? count + 1 : Math.max(0, count - 1);
  
  // ローカルストレージに保存
  localStorage.setItem(storageKey, isLiked.toString());
  localStorage.setItem(`${storageKey}_count`, count.toString());
  
  // UIを更新
  updateLikeUI();
});
</script> 