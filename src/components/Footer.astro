<footer class="footer-container">
    <div class="links-left"></div>
    <h2><span>@2025</span> KanikanLab</h2>
    <div class="links-right">
        <a href="/privacy-policy">プライバシーポリシー</a>
        <span class="divider"></span>
        <a href="">免責事項</a>
    </div>
</div>

<style>
    .footer-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #ccc;
        padding: 15px 80px;
        background-color: #fff;
        z-index: 10;
    }
    
    .footer-container h2 {
        font-family: 'Krok', sans-serif;
        font-size: 16px;
        flex-grow: 1;
        text-align: center;
        letter-spacing: 0.1em;
    }
    
    .footer-container h2 span {
        font-family: 'Anonymous pro', sans-serif;
        letter-spacing: 0;
    }
    
    .links-left {
        flex: 1;
    }
    
    .links-right {
        flex: 1;
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        align-items: center;
    }
    
    .links-right a {
        text-decoration: none;
        color: inherit;
    }
    
    .divider {
        display: inline-block;
        width: 1px;
        height: 14px;
        background-color: #cccccc;
        margin: 0 5px;
    }

    body {
        margin: 0;
        min-height: 100vh;
    }
    
    .site-wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    
    .site-content {
        flex: 1;
    }
</style>