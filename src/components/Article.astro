---
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';

interface Props {
    post: any; // Cosmic CMS post object
}

const { post } = Astro.props;
const title = post.title;
const description = post.metadata?.description || '';
const pubdate = post.metadata?.pubdate || post.created_at;
const heroimage = post.metadata?.heroimage?.imgix_url || post.metadata?.heroimage?.url;
const categories = post.metadata?.categories?.map(c => c.category) || [];
---

<article class="article-card">
    <a href={`/blog/${post.slug}/`} class="article-link">
        {heroimage && (
            <div class="article-image">
                {categories && categories.length > 0 && (
                    <div class="article-tags">
                        {categories.map((category: string) => (
                            <span class="tag"><i class="fas fa-tag"></i> {category}</span>
                        ))}
                    </div>
                )}
                <img src={heroimage} alt={title} width={800} height={400} />
            </div>
        )}
        <div class="article-content">
            <h2 class="article-title">{title}</h2>
            <p class="article-date">
                <FormattedDate date={pubdate} />
            </p>
        </div>
    </a>
</article>
<style>
    .article-card {
        background-color: var(--card-bg);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px var(--card-shadow);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 2rem;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px var(--card-shadow);
    }

    .article-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        color: var(--text-color);
        text-decoration: none;
    }

    .article-image {
        width: 100%;
        height: 200px;
        overflow: hidden;
        position: relative;
    }

    .article-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .article-card:hover .article-image img {
        transform: scale(1.05);
    }

    .article-content {
        padding: 1.5rem;
        padding-bottom: 0;
        text-align: left;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .article-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.5rem;
        color: var(--text-color);
        text-align: left;
    }

    .article-date {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        text-align: left;
        font-family: 'anonmous pro', monospace;
    }

    .article-description {
        margin-bottom: 1rem;
        color: var(--text-color);
        line-height: 1.5;
        text-align: left;
    }

    .read-more {
        display: inline-block;
        color: var(--accent-color);
        font-weight: 500;
        text-align: left;
    }
    
    .article-tags {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 10;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        pointer-events: none;
    }

    .tag {
        background-color: var(--bg-color);
        color: var(--text-color);
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 5px;
        box-shadow: 0 2px 4px var(--card-shadow);
        transition: all 0.3s ease;
    }

    .tag i {
        font-size: 0.75rem;
    }

    .tag:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 6px var(--card-shadow);
    }

    @media (max-width: 768px) {
        .article-image {
            height: 150px;
        }

        .article-title {
            font-size: 1.2rem;
        }

        .article-content {
            padding: 1rem;
        }
    }
</style>
