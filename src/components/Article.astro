---
import { type CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { callSafely } from 'astro:actions';

interface Props {
    post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, categories = [] } = post.data;
---
<article class="article-card">
    <a href={`/blog/${post.slug}/`} class="article-link">
        {heroImage && (
            <div class="article-image">
                {categories && categories.length > 0 && (
                    <div class="article-tags">
                        {categories.map((tag: string) => (
                            <span class="tag">{tag}</span>
                        ))}
                    </div>
                )}
                <img src={import.meta.env.BASE_URL + heroImage.replace(/^\//, '')} alt={title} />
            </div>
        )}
        <div class="article-content">
            <h2 class="article-title">{title}</h2>
            <p class="article-date">
                <FormattedDate date={pubDate} />
            </p>
            <p class="article-description">{description}</p>

            <span class="read-more">続きを読む →</span>
        </div>
    </a>
</article>
<style>
    .article-card {
        background-color: var(--color-bg-secondary);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        margin-bottom: 2rem;
    }

    .article-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
    }

    .article-link {
        display: block;
        color: inherit;
        text-decoration: none;
    }

    .article-image {
        width: 100%;
        height: 200px;
        overflow: hidden;
        position: relative;
    }

    .article-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .article-card:hover .article-image img {
        transform: scale(1.05);
    }

    .article-content {
        padding: 1.5rem;
        text-align: left;
    }

    .article-title {
        margin: 0 0 0.5rem 0;
        font-size: 1.5rem;
        color: var(--color-text);
        text-align: left;
    }

    .article-date {
        font-size: 0.9rem;
        color: var(--color-text-light);
        margin-bottom: 1rem;
        text-align: left;
        font-family: 'anonmous pro', monospace;
    }

    .article-description {
        margin-bottom: 1rem;
        color: var(--color-text);
        line-height: 1.5;
        text-align: left;
    }

    .read-more {
        display: inline-block;
        color: var(--color-primary);
        font-weight: 500;
        text-align: left;
    }
    
    .article-tags {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 10;
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        pointer-events: none;
    }

    .tag {
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 500;
    }

    @media (max-width: 768px) {
        .article-image {
            height: 150px;
        }

        .article-title {
            font-size: 1.2rem;
        }

        .article-content {
            padding: 1rem;
        }
    }
</style>
