---
import MainLayout from '../layouts/MainLayout.astro';
import Article from '../components/Article.astro';
import Sidebar from '../components/Sidebar.astro';
import SearchBox from '../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';

import '../styles/blog.css';

// Get the search query from the URL (for initializing the search box)
const query = Astro.url.searchParams.get('q') || '';

// Get all blog posts
const allPosts = await getCollection('blog');

// Get the BASE_URL for image paths
const BASE_URL = import.meta.env.BASE_URL || '';

// Convert posts to a format that can be used in client-side JavaScript
const serializedPosts = allPosts.map(post => ({
  slug: post.slug,
  title: post.data.title,
  description: post.data.description || '',
  pubDate: post.data.pubDate.toISOString(),
  heroImage: post.data.heroImage || '',
  categories: post.data.categories || [],
  content: post.body
}));
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="blog-header">
                <h1>検索結果</h1>
                <div class="search-container">
                    <SearchBox initialValue={query} />
                </div>
                <div id="search-info">
                    <p>検索中...</p>
                </div>
            </div>

            <div id="search-results" class="blog-grid">
                <!-- すべての記事を非表示状態で事前レンダリング -->
                {allPosts.map((post) => (
                    <div class="article-wrapper" data-slug={post.slug} style="display: none;">
                        <Article post={post} />
                    </div>
                ))}
            </div>
            <div id="no-results" class="no-posts" style="display: none;">
                <p id="no-results-message"></p>
                <p>別のキーワードで検索してみてください。</p>
            </div>
            
            <div class="back-link-container">
                <a href="/blog" class="back-link">← ブログトップに戻る</a>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>

<script define:vars={{ serializedPosts, BASE_URL }}>
// Client-side search implementation
document.addEventListener('DOMContentLoaded', () => {
    const searchInfo = document.getElementById('search-info');
    const searchResults = document.getElementById('search-results');
    const noResults = document.getElementById('no-results');
    const noResultsMessage = document.getElementById('no-results-message');
    const articleWrappers = document.querySelectorAll('.article-wrapper');
    
    // Get the query parameter directly from the URL
    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q') || '';
    
    // If no query, show message
    if (!query) {
        searchInfo.innerHTML = '<p>検索キーワードを入力してください</p>';
        return;
    }
    
    // Filter posts based on the search query
    const filteredPosts = serializedPosts.filter(post => {
        const title = post.title.toLowerCase();
        const description = post.description.toLowerCase();
        const content = post.content.toLowerCase();
        const searchQuery = query.toLowerCase();
        
        return title.includes(searchQuery) || 
               description.includes(searchQuery) || 
               content.includes(searchQuery);
    });
    
    // Sort filtered posts by publication date (newest first)
    const sortedPosts = filteredPosts.sort((a, b) => 
        new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf()
    );
    
    // Update search info
    searchInfo.innerHTML = `<p>「${query}」の検索結果: ${sortedPosts.length}件</p>`;
    
    // If no results, show message
    if (sortedPosts.length === 0) {
        noResultsMessage.textContent = `「${query}」に一致する記事が見つかりませんでした。`;
        noResults.style.display = 'block';
        return;
    }
    
    // 検索結果に一致する記事のみを表示
    const matchingSlugs = sortedPosts.map(post => post.slug);
    
    articleWrappers.forEach(wrapper => {
        const slug = wrapper.getAttribute('data-slug');
        if (matchingSlugs.includes(slug)) {
            wrapper.style.display = 'block';
        } else {
            wrapper.style.display = 'none';
        }
    });
    
    // 記事を正しい順序で表示するためにソート
    const sortArticleWrappers = () => {
        const parent = searchResults;
        const wrappers = Array.from(parent.querySelectorAll('.article-wrapper[style="display: block;"]'));
        
        // matchingSlugsの順序に従ってソート
        wrappers.sort((a, b) => {
            const slugA = a.getAttribute('data-slug');
            const slugB = b.getAttribute('data-slug');
            return matchingSlugs.indexOf(slugA) - matchingSlugs.indexOf(slugB);
        });
        
        // ソートされた要素を再配置
        wrappers.forEach(wrapper => {
            parent.appendChild(wrapper);
        });
    };
    
    sortArticleWrappers();
});
</script>