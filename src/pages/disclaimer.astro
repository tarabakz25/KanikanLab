  { depth: 2, slug: '1-情報の正確性について', text: '1. 情報の正確性について' },
  { depth: 2, slug: '2-損害責任の制限', text: '2. 損害責任の制限' },
  { depth: 2, slug: '3-著作権について', text: '3. 著作権について' },
  { depth: 2, slug: '4-リンクポリシー', text: '4. リンクポリシー' },
  { depth: 3, slug: '41-外部サイトへのリンク', text: '4.1 外部サイトへのリンク' },
  { depth: 3, slug: '42-当サイトへのリンク', text: '4.2 当サイトへのリンク' },
  { depth: 2, slug: '5-当サイトの利用条件', text: '5. 当サイトの利用条件' },
  { depth: 2, slug: '6-サービス内容の変更', text: '6. サービス内容の変更' },
