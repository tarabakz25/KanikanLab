---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getAllPosts, getPostBySlug } from '../../lib/cosmic';
import { marked } from 'marked';
import MainLayout from '../../layouts/MainLayout.astro';

// 静的プリレンダリングを有効にする（オプション）
export const prerender = true;

export async function getStaticPaths() {
    const posts = await getAllPosts();
    return posts.map((post: any) => ({
        params: { slug: post.slug },
        props: { slug: post.slug },
    }));
}

interface Props {
    slug: string;
}

// ヘッディングの型定義
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

const { slug } = Astro.params;
console.log('要求されたスラッグ:', slug);
let post: any;
let headings: Heading[] = [];
let blogId = '';
let layoutProps: any;
let htmlContent = '';

try {
    post = await getPostBySlug(slug);
    
    if (post) {
        console.log('Post object structure:', {
            id: post.id
        });
        console.log('Complete post object:', post);
        
        // post.idが存在する場合はblogIdに設定
        blogId = post.id || '';
        console.log('Using blogId:', blogId);
        
        // Extract headings from content for table of contents
        const extractHeadings = (content: string): Heading[] => {
            const headings: Heading[] = [];
            
            // Simple regex to extract headings
            const headingRegex = /^(#{1,6})\s+(.+)$/gm;
            let match;
            
            while ((match = headingRegex.exec(content)) !== null) {
                const level = match[1].length;
                const text = match[2].trim();
                const slug = text.toLowerCase().replace(/[^\w]+/g, '-');
                
                headings.push({
                    depth: level,
                    slug,
                    text
                });
            }
            
            return headings;
        };

        const content = post.metadata?.content || '';
        headings = extractHeadings(content);
        htmlContent = await marked.parse(content) as string;
        
        layoutProps = {
            title: post.title,
            description: post.metadata?.description || '',
            pubdate: new Date(post.metadata?.pubdate || post.created_at),
            heroimage: post.metadata?.heroimage?.imgix_url || post.metadata?.heroimage?.url,
            categories: post.metadata?.categories?.map((c: any) => c.category) || [],
            headings, 
            blogId,   
            slug      // スラッグを渡す
        };
        
        console.log('Final layoutProps blogId:', layoutProps.blogId);
    } else {
        // 記事が見つからない場合の処理
        layoutProps = {
            title: '記事が見つかりません',
            description: '',
            pubdate: new Date(),
            heroimage: '',
            categories: [],
            headings: [], 
            blogId: '',
            slug
        };
    }
} catch (error) {
    console.error('記事取得エラー:', error);
    
    // エラー時のフォールバック
    layoutProps = {
        title: 'エラーが発生しました',
        description: '',
        pubdate: new Date(),
        heroimage: '',
        categories: [],
        headings: [],
        blogId: '',
        slug
    };
}

// 最終的なlayoutPropsの確認
console.log('Final layoutProps blogId:', layoutProps.blogId);
---

<BlogLayout {...layoutProps}>
    {post ? (
        <div set:html={htmlContent} />
    ) : (
        <div class="error-message">
            <h1>記事が見つかりませんでした</h1>
            <p><a href="/blog">ブログ一覧に戻る</a></p>
        </div>
    )}
</BlogLayout>

<style>
    .error-container {
        max-width: 800px;
        margin: 5rem auto;
        padding: 2rem;
        text-align: center;
    }
    
    .back-link {
        display: inline-block;
        margin-top: 2rem;
        color: var(--color-primary);
        text-decoration: none;
    }
    
    .back-link:hover {
        text-decoration: underline;
    }
</style>
