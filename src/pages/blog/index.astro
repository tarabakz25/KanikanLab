---
import MainLayout from '../../layouts/MainLayout.astro';
import Article from '../../components/Article.astro';
import Sidebar from '../../components/Sidebar.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getPaginatedPosts } from '../../lib/cosmic';
import { SITE_TITLE } from '../../consts';

import '../../styles/blog.css';

// Get posts from Cosmic CMS with pagination
const pageSize = 6;
const { posts, total } = await getPaginatedPosts(pageSize, 0);

// Calculate pagination info
const hasMorePages = total > pageSize;
const nextPage = hasMorePages ? '/blog/page/2' : undefined;
const totalPages = Math.max(1, Math.ceil(total / pageSize));
const currentPage = 1;

// Debug information
console.log(`Blog index: Total posts: ${total}`);
console.log(`Blog index: Posts array:`, posts);
console.log(`Blog index: Has more pages: ${hasMorePages}`);
console.log(`Blog index: Next page: ${nextPage}`);
console.log(`Blog index: Total pages: ${totalPages}`);
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="blog-header">
                <h1>{SITE_TITLE} 情報格納庫</h1>
                <p>最新の情報を共有中... ゆっくりみていってください。</p>
                <div class="search-container">
                    <SearchBox />
                </div>
            </div>

            <div class="blog-grid">
                {posts.map((post) => (
                    <Article post={post} />
                ))}
            </div>

            {posts.length === 0 && (
                <div class="no-posts">
                    <p>まだ記事がありません。</p>
                    <p>もうしばらくお待ちください。</p>
                </div>
            )}

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ {currentPage} / {totalPages}</span>
                </div>
                <div class="pagination-controls">
                    {currentPage > 1 ? (
                        <a href={`/blog/page/${currentPage - 1}`} class="pagination-prev">前のページ</a>
                    ) : (
                        <span class="pagination-prev disabled">前のページ</span>
                    )}
                    
                    {hasMorePages ? (
                        <a href={`/blog/page/${currentPage + 1}`} class="pagination-next">次のページ</a>
                    ) : (
                        <span class="pagination-next disabled">次のページ</span>
                    )}
                </div>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>
