---
import MainLayout from '../../layouts/MainLayout.astro';
import Article from '../../components/Article.astro';
import Sidebar from '../../components/Sidebar.astro';
import SearchBox from '../../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

import '../../styles/blog.css';

// Get all blog posts sorted by publication date (newest first)
const posts = await getCollection('blog');
console.log("All posts:", posts.map(p => p.slug));
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get only the first 6 posts for the first page
const pageSize = 6;
const firstPagePosts = sortedPosts.slice(0, pageSize);
const hasMorePages = sortedPosts.length > pageSize;
const nextPage = hasMorePages ? '/blog/page/2' : undefined;
const totalPages = Math.ceil(sortedPosts.length / pageSize);
const currentPage = 1;

// Debug information
console.log(`Total posts: ${sortedPosts.length}`);
console.log(`Has more pages: ${hasMorePages}`);
console.log(`Next page: ${nextPage}`);
console.log(`Total pages: ${totalPages}`);
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="blog-header">
                <h1>{SITE_TITLE} 情報格納庫</h1>
                <p>最新の情報を共有中... ゆっくりみていってください。</p>
                <div class="search-container">
                    <SearchBox />
                </div>
            </div>

            <div class="blog-grid">
                {firstPagePosts.map((post) => (
                    <Article post={post} />
                ))}
            </div>

            {firstPagePosts.length === 0 && (
                <div class="no-posts">
                    <p>まだ記事がありません。</p>
                    <p>もうしばらくお待ちください。</p>
                </div>
            )}

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ {currentPage} / {totalPages}</span>
                </div>
                <div class="pagination-controls">
                    {currentPage > 1 ? (
                        <a href={`/blog/page/${currentPage - 1}`} class="pagination-prev">前のページ</a>
                    ) : (
                        <span class="pagination-prev disabled">前のページ</span>
                    )}
                    
                    {hasMorePages ? (
                        <a href={`/blog/page/${currentPage + 1}`} class="pagination-next">次のページ</a>
                    ) : (
                        <span class="pagination-next disabled">次のページ</span>
                    )}
                </div>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>
