---
import MainLayout from '../../../layouts/MainLayout.astro';
import Article from '../../../components/Article.astro';
import Sidebar from '../../../components/Sidebar.astro';
import SearchBox from '../../../components/SearchBox.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE } from '../../../consts';

import '../../../styles/blog.css';

// Define the page type
interface Page {
    data: CollectionEntry<'blog'>[];
    start: number;
    end: number;
    total: number;
    currentPage: number;
    size: number;
    lastPage: number;
    url: {
        current: string;
        prev: string | undefined;
        next: string | undefined;
    };
}

export async function getStaticPaths({ paginate }: { paginate: Function }) {
    const posts = await getCollection('blog');
    const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    
    // 6記事ごとにページを生成
    return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props as { page: Page };
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="blog-header">
                <h1>{SITE_TITLE} 情報格納庫</h1>
                <p>最新の情報を共有中... ゆっくりみていってください。</p>
                <div class="search-container">
                    <SearchBox />
                </div>
            </div>

            <div class="blog-grid">
                {page.data.map((post: CollectionEntry<'blog'>) => (
                    <Article post={post} />
                ))}
            </div>

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ {page.currentPage} / {page.lastPage}</span>
                </div>
                <div class="pagination-controls">
                    {page.url.prev ? (
                        <a href={page.url.prev} class="pagination-prev">前のページ</a>
                    ) : (
                        <span class="pagination-prev disabled">前のページ</span>
                    )}
                    
                    {page.url.next ? (
                        <a href={page.url.next} class="pagination-next">次のページ</a>
                    ) : (
                        <span class="pagination-next disabled">次のページ</span>
                    )}
                </div>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>
