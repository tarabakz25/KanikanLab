---
import MainLayout from '../../../layouts/MainLayout.astro';
import Article from '../../../components/Article.astro';
import Sidebar from '../../../components/Sidebar.astro';
import SearchBox from '../../../components/SearchBox.astro';
import { getPaginatedPosts } from '../../../lib/cosmic';
import { SITE_TITLE } from '../../../consts';

import '../../../styles/blog.css';

export async function getStaticPaths() {
    const pageSize = 6;
    const { total } = await getPaginatedPosts(1, 0); // Just to get total count
    const totalPages = Math.ceil(total / pageSize);
    
    // Generate paths for all pages
    return Array.from({ length: totalPages }).map((_, i) => {
        const pageNum = i + 1;
        return {
            params: { page: pageNum.toString() },
            props: { currentPage: pageNum, totalPages }
        };
    });
}

interface Props {
    currentPage: number;
    totalPages: number;
}

const { currentPage, totalPages } = Astro.props;
const pageSize = 6;
const skip = (currentPage - 1) * pageSize;

// Fetch posts for current page
const { posts } = await getPaginatedPosts(pageSize, skip);

// Calculate pagination URLs
const prevPage = currentPage > 1 ? `/blog/page/${currentPage - 1}` : undefined;
const nextPage = currentPage < totalPages ? `/blog/page/${currentPage + 1}` : undefined;
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="blog-header">
                <h1>{SITE_TITLE} 情報格納庫</h1>
                <p>最新の情報を共有中... ゆっくりみていってください。</p>
                <div class="search-container">
                    <SearchBox />
                </div>
            </div>

            <div class="blog-grid">
                {posts.map((post) => (
                    <Article post={post} />
                ))}
            </div>

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ {currentPage} / {totalPages}</span>
                </div>
                <div class="pagination-controls">
                    {prevPage ? (
                        <a href={prevPage} class="pagination-prev">前のページ</a>
                    ) : (
                        <span class="pagination-prev disabled">前のページ</span>
                    )}
                    
                    {nextPage ? (
                        <a href={nextPage} class="pagination-next">次のページ</a>
                    ) : (
                        <span class="pagination-next disabled">次のページ</span>
                    )}
                </div>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>
