---
import MainLayout from '../../../layouts/MainLayout.astro';
import Article from '../../../components/Article.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getAllPosts, getPostsByCategory } from '../../../lib/cosmic';

import '../../../styles/blog.css';

export async function getStaticPaths() {
    const allPosts = await getAllPosts();
    
    // すべての投稿からカテゴリーを抽出
    const categoriesWithDuplicates = allPosts.flatMap(post => {
        const categories = post.metadata?.categories || [];
        return categories.map(cat => 
            typeof cat === 'object' && cat.category ? cat.category : cat
        );
    });
    
    // 重複を除去
    const allCategories = [...new Set(categoriesWithDuplicates)];
    
    console.log('Generated static paths for categories:', allCategories);
    
    return allCategories.map(category => ({
        params: { page: category },
        props: { category }
    }));
}

interface Props {
    category: string;
}

const { category } = Astro.props;
console.log('Category from props:', category);
const posts = await getPostsByCategory(category);
console.log('Posts data:', posts);
const totalPosts = posts.length;
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="category-header">
                <h1>カテゴリー: {category}</h1>
                <p>{totalPosts} 件の記事</p>
            </div>

            <div class="blog-grid">
                {posts.map((post) => (
                    <Article post={post} />
                ))}
            </div>

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ 1 / 1</span>
                </div>
                <div class="pagination-controls">
                    <span class="pagination-prev disabled">前のページ</span>
                    <span class="pagination-next disabled">次のページ</span>
                </div>
            </div>

            <div class="back-link-container">
                <a href="/blog" class="back-link">← ブログ一覧に戻る</a>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>

<style>
    .blog-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
        display: grid;
        grid-template-columns: 3fr 1fr;
        gap: 2rem;
    }

    .blog-content {
        width: 100%;
    }

    .category-header {
        margin-bottom: 2rem;
    }

    .category-header h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        color: var(--text-color);
    }

    .category-header p {
        font-size: 1rem;
        color: var(--text-color);
        opacity: 0.8;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }

    .back-link-container {
        margin-top: 2rem;
    }

    .back-link {
        display: inline-block;
        color: var(--text-color);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .back-link:hover {
        color: var(--hover-bg);
        text-decoration: underline;
    }

    @media (max-width: 768px) {
        .blog-container {
            grid-template-columns: 1fr;
        }

        .blog-grid {
            grid-template-columns: 1fr;
        }

        .category-header h1 {
            font-size: 1.5rem;
        }
    }
</style>
