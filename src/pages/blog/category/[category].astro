---
import MainLayout from '../../../layouts/MainLayout.astro';
import Article from '../../../components/Article.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { getAllPosts, getPostsByCategory } from '../../../lib/cosmic';

import '../../../styles/blog.css';

export async function getStaticPaths() {
    const allPosts = await getAllPosts();
    
    // すべての投稿からカテゴリーを抽出
    const categoriesWithDuplicates = allPosts.flatMap(post => {
        const categories = post.metadata?.categories || [];
        return categories.map(cat => 
            typeof cat === 'object' && cat.category ? cat.category : cat
        );
    });
    
    // 重複を除去
    const allCategories = [...new Set(categoriesWithDuplicates)];
    
    console.log('生成されたカテゴリーパス:', allCategories);
    
    return allCategories.map(category => {
        console.log(`カテゴリー「${category}」のルートを生成中`);
        return {
            params: { category },
            props: { category }
        };
    });
}

// props の型定義も変更
interface Props {
    category: string;
}

const { category } = Astro.params;
console.log('Category from props:', category);
console.log('カテゴリーパラメーター:', category);
const posts = await getPostsByCategory(category);
console.log('カテゴリー用に取得した記事数:', posts.length);
console.log('Posts data:', JSON.stringify(posts.map(p => ({ title: p.title, slug: p.slug })), null, 2));
const totalPosts = posts.length;
---

<MainLayout>
    <div class="blog-container">
        <div class="blog-content">
            <div class="category-header">
                <h1>カテゴリー: {category}</h1>
                <p>{totalPosts} 件の記事</p>
            </div>

            <div class="blog-grid">
                {posts.map((post) => (
                    <Article post={post} />
                ))}
            </div>

            <div class="pagination">
                <div class="pagination-info">
                    <span>ページ 1 / 1</span>
                </div>
                <div class="pagination-controls">
                    <span class="pagination-prev disabled">前のページ</span>
                    <span class="pagination-next disabled">次のページ</span>
                </div>
            </div>

            <div class="back-link-container">
                <a href="/blog" class="back-link">← ブログ一覧に戻る</a>
            </div>
        </div>
        
        <div class="blog-sidebar">
            <Sidebar />
        </div>
    </div>
</MainLayout>

<style>
    .blog-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
        display: grid;
        grid-template-columns: 3fr 1fr;
        gap: 2rem;
    }

    .blog-content {
        width: 100%;
    }

    .category-header {
        margin-bottom: 2rem;
    }

    .category-header h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        color: var(--text-color);
    }

    .category-header p {
        font-size: 1rem;
        color: var(--text-color);
        opacity: 0.8;
    }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
    }

    .back-link-container {
        margin-top: 2rem;
    }

    .back-link {
        display: inline-block;
        color: var(--text-color);
        text-decoration: none;
        font-weight: 500;
        position: relative;
    }

    .back-link::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1px;
        bottom: 0;
        left: 0;
        background-color: var(--text-color);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease;
    }

    .back-link:hover::after {
        transform: scaleX(1);
    }

    @media (max-width: 768px) {
        .blog-container {
            grid-template-columns: 1fr;
        }

        .blog-grid {
            grid-template-columns: 1fr;
        }

        .category-header h1 {
            font-size: 1.5rem;
        }
    }
</style>
