---
import MainLayout from '../layouts/MainLayout.astro';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchBox from '../components/SearchBox.astro';
import Article from '../components/Article.astro';

import { Image } from 'astro:assets';
import background from '../assets/bg.webp';
import { getCollection } from 'astro:content';

// Get the 3 most recent blog posts
const allPosts = await getCollection('blog');
const recentPosts = allPosts
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<MainLayout>
	<div class="top-page__background">
		<div class="image-container">
			<Image src={background} alt="background" />
			<div class="overlay"></div>
		</div>
		<div class="title-container">
			<span>Welcome to</span>
			<span>Kanikan Lab!</span>
		</div>
	</div>
	<div class="article-page">
		<div class="search-box"><SearchBox /></div>
		<div class="article-container">
			<h2 class="section-title">最新の記事</h2>
			<section class="recent-posts">
				{recentPosts.map((post) => (
					<Article post={post} />
				))}
				{recentPosts.length === 0 && (
					<p class="no-posts">まだ記事がありません。</p>
				)}
			</section>
			<div class="view-all">
				<a href="/blog" class="view-all-link">すべての記事を見る &rarr;</a>
			</div>
		</div>
	</div>
</MainLayout>

<style>
	.top-page__background {
		width: 100%;
		box-sizing: border-box;
		overflow: hidden;
		position: relative;
	}
	.image-container {
		position: relative;
		width: 100%;
	}
	.image-container img {
		width: 100%;
		display: block; /* これを追加して余分なスペースを除去 */
		object-fit: cover;
		object-position: center;
	}
	.overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.3); /* 黒い半透明オーバーレイ */
	}
	.title-container {
		position: absolute;
		bottom: 2rem;
		left: 2rem;
		display: flex;
		flex-direction: column;
		z-index: 1; /* テキストをオーバーレイの上に表示 */
	}
	.top-page__background span {
		color: #FFF;
		font-family: 'Krok', sans-serif;
		font-size: 60px;
		font-style: normal;
		font-weight: 400;
		line-height: normal;
		letter-spacing: 9.6px;
		display: block;
		margin-bottom: 0.5rem;
	}
	.article-page {
		margin: 0 auto;
		width: 100%;
		text-align: center;
	}
	.article-page .search-box {
		margin: 120px auto 60px;
		max-width: 600px; /* 必要に応じて調整 */
		display: inline-block;
	}

	.article-container {
		max-width: 1200px;
		margin: 0 auto 80px;
		padding: 0 1rem;
	}

	.section-title {
		font-size: 2rem;
		margin-bottom: 2rem;
		text-align: center;
		color: var(--color-text);
	}

	.recent-posts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.no-posts {
		text-align: center;
		padding: 2rem 0;
		color: var(--color-text-light);
		grid-column: 1 / -1;
	}

	.view-all {
		text-align: center;
		margin-top: 2rem;
	}

	.view-all-link {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background-color: var(--color-primary);
		color: white;
		text-decoration: none;
		border-radius: 4px;
		font-weight: 500;
		transition: background-color 0.3s ease;
	}

	.view-all-link:hover {
		background-color: var(--color-primary-dark);
	}

	@media (max-width: 768px) {
		.recent-posts {
			grid-template-columns: 1fr;
		}

		.section-title {
			font-size: 1.5rem;
		}
	}
</style>
