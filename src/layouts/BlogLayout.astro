---
import MainLayout from './MainLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LikeAndShareBar from '../components/LikeAndShareBar.astro';
import { format } from 'date-fns';
import { Image } from 'astro:assets';

import '../styles/blog.css';
import '../styles/BlogLayout.css';


interface Props {
    title: string;
    description: string;
    pubdate: Date;
    heroimage?: string;
    categories?: string[];
    headings?: { depth: number; slug: string; text: string }[];
    blogId: string;
}

const { title, description, pubdate, heroimage, categories, headings = [], blogId } = Astro.props;

// Debug: Log the blogId received by BlogLayout
console.log('BlogLayout received blogId:', blogId);

const { slug } = Astro.props.frontmatter || Astro.props;

// Propsから記事データを取得
const { frontmatter: post } = Astro.props;

// OGP情報を設定
const pageTitle = post.title ? `${post.title} | KanikanLab` : 'KanikanLab';
const pageDescription = post.metadata?.excerpt || post.metadata?.description || 'KanikanLabのブログ記事'; // 抜粋があれば使う
// ↓ ヘッダー画像のURLを特定 (実際のキー名に置き換えてください)
const ogpImage = post.metadata?.hero?.imgix_url || '/default-ogp-image.png'; // デフォルト画像を指定

// デバッグ用に画像URLをログ出力
console.log("OGP Image URL:", ogpImage);
---
<MainLayout title={pageTitle} description={pageDescription} image={ogpImage}>
    <div class="blog-container">
        <div class="blog-main">
            <article class="blog-post">
                <Breadcrumbs title={title} categories={categories} />
                <div class="blog-header">
                    {heroimage && (
                        <div class="hero-image">
                            <Image 
                                src={heroimage.startsWith('http') ? heroimage : import.meta.env.BASE_URL + heroimage.replace(/^\//, '')} 
                                alt={title} 
                                width={800}
                                aspectRatio="16:9"
                                class="post-hero-image"
                            />
                        </div>
                    )}
                    <div class="blog-meta">
                        <h1 class="blog-title">{title}</h1>
                        <div class="blog-date">
                            <span>公開日: <FormattedDate date={pubdate} /></span>
                        </div>
                        {categories && categories.length > 0 && (
                            <div class="blog-categories">
                                {categories.map((category) => (
                                    <a href={`/blog/category/${category}`} class="category-link">
                                        <i class="fas fa-tag"></i> {category}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                </div>
                <div class="blog-content">
                    <slot />
                </div>
                <div class="blog-footer">
                    <LikeAndShareBar slug={slug} title={title} />
                    <a href="/blog" class="back-link">← ブログ一覧に戻る</a>
                </div>
            </article>
        </div>
        
        <div class="blog-sidebar">
            {headings && headings.length > 0 && (
                <TableOfContents headings={headings} />
            )}
            <Sidebar />
        </div>
    </div>
</MainLayout>
