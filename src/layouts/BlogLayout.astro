---
import MainLayout from './MainLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LikeAndShareBar from '../components/LikeAndShareBar.astro';
import { Image } from 'astro:assets';

import '../styles/blog.css';
import '../styles/BlogLayout.css';



interface Props {
    title: string;
    description: string;
    pubdate: Date;
    heroimage?: string;
    categories?: string[];
    headings?: { depth: number; slug: string; text: string }[];
    blogId: string;
    slug?: string; // slugプロパティを追加
}

const { title = '記事が見つかりません', description = '', pubdate, heroimage, categories = [], headings = [], blogId = '', slug = '' } = Astro.props;

// Debug: Log the blogId received by BlogLayout
console.log('BlogLayout received blogId:', blogId);

// 重複宣言を避けるため、別の変数名を使う
const currentSlug = slug;

// Propsから記事データを取得
// const { frontmatter: post } = Astro.props; // この行を削除

// OGP情報を設定
const pageTitle = title ? `${title} | KanikanLab` : 'KanikanLab'; // post.title の代わりに title を使用
const pageDescription = description || 'KanikanLabのブログ記事'; // post.metadata?.excerpt や post.metadata?.description の代わりに description を使用
// Calculate OGP image URL using heroimage prop, handling relative/absolute paths
const ogpImage = heroimage
    ? (heroimage.startsWith('http') ? heroimage : (import.meta.env.BASE_URL + heroimage.replace(/^\//, '')))
    : '/default-ogp-image.png'; // post.metadata?.hero?.imgix_url の代わりに heroimage を使用し、パスを解決

// デバッグ用に画像URLをログ出力
console.log("OGP Image URL:", ogpImage);
---
<MainLayout title={pageTitle} description={pageDescription} image={ogpImage}>
    <div class="blog-container">
        <div class="blog-main">
            <article class="blog-post">
                <Breadcrumbs title={title} categories={categories} />
                <div class="blog-header">
                    {heroimage && (
                        <div class="hero-image">
                            <Image 
                                src={heroimage.startsWith('http') ? heroimage : import.meta.env.BASE_URL + heroimage.replace(/^\//, '')} 
                                alt={title} 
                                width={800}
                                height={450}
                                class="post-hero-image"
                            />
                        </div>
                    )}
                    <div class="blog-meta">
                        <h1 class="blog-title">{title}</h1>
                        <div class="blog-date">
                            <span>公開日: <FormattedDate date={pubdate} /></span>
                        </div>
                        {categories && categories.length > 0 && (
                            <div class="blog-categories">
                                {categories.map((category) => (
                                    <a href={`/blog/category/${category}`} class="title-category-link">
                                        <i class="fas fa-tag"></i> {category}
                                    </a>
                                ))}
                            </div>
                        )}
                    </div>
                </div>
                <div class="blog-content">
                    <slot />
                </div>
                <div class="blog-footer">
                    <LikeAndShareBar slug={currentSlug} title={title} />
                    <a href="/blog" class="back-link">← ブログ一覧に戻る</a>
                </div>
            </article>
        </div>
        
        <div class="blog-sidebar">
            {headings && headings.length > 0 && (
                <TableOfContents headings={headings} />
            )}
            <Sidebar />
        </div>
    </div>
</MainLayout>
